{
  "name": "budgetmint-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -p . && pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "test:failed": "pnpm -r test --last-failed --passWithNoTests",
    "test:scripts": "node --test 'scripts/**/*.test.mjs'",
    "test:emulator": "scripts/test-emulator.sh",
    "build:wasm": "node scripts/build-wasm.mjs",
    "brand": "node scripts/brand/render.mjs",
    "firebase": "npx --yes firebase-tools@15.35.0",
    "dev": "pnpm --filter @budgetmint/desktop dev",
    "tauri": "pnpm --filter @budgetmint/desktop tauri",
    "check:coverage-policy": "node scripts/check-coverage-policy.mjs",
    "upstream:check": "node scripts/sync-upstream.mjs --check",
    "upstream:pull": "node scripts/sync-upstream.mjs --pull",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "prepare": "node scripts/install-hooks.mjs",
    "verify": "scripts/verify.sh",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@firebase/rules-unit-testing": "6.0.0",
    "@resvg/resvg-js": "catalog:",
    "@types/node": "catalog:",
    "firebase": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
