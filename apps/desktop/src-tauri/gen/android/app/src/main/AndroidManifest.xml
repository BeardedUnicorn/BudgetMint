<?xml version="1.0" encoding="utf-8"?>
<!-- Adapted from TaskMint apps/desktop/src-tauri/gen/android/app/src/main/AndroidManifest.xml @ ce9f22f. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- BudgetMint: no advertising ID or ad attribution. Firebase Analytics'
         SDK brings these permissions in; usage statistics need none of them
         (the privacy page says so). -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />
    <!-- A bill's reminder fires at its exact time (the
         notification plugin falls back to an inexact alarm without these).
         USE_EXACT_ALARM is granted at install from Android 13; Android 12
         needs SCHEDULE_EXACT_ALARM. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />

    <!-- BudgetMint: no backups (res/xml/data_extraction_rules.xml says why);
         allowBackup covers Android 11 and earlier, the rules 12 and later. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:targetApi="s"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.budgetmint"
        android:networkSecurityConfig="@xml/network_security_config">
        <!-- BudgetMint: Analytics collects no advertising ID, and its data isn't
             for personalised ads. -->
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_default_allow_ad_personalization_signals" android:value="false" />
        <!-- BudgetMint: a dev build (BUDGETMINT_ENV, app/build.gradle.kts)
             never collects Analytics -->
        <meta-data
            android:name="firebase_analytics_collection_deactivated"
            android:value="${analyticsDeactivated}" />
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:theme="@style/Theme.budgetmint.Starting"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- BudgetMint: the home screen's widgets (widgets/Widgets.kt), and the
             screen that picks a Savings goal widget's goal. -->
        <receiver
            android:name=".widgets.SafeToSpendReceiver"
            android:label="@string/widget_safe_to_spend"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_safe_to_spend" />
        </receiver>
        <receiver
            android:name=".widgets.ComingUpReceiver"
            android:label="@string/widget_coming_up"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_coming_up" />
        </receiver>
        <receiver
            android:name=".widgets.ThisWeekReceiver"
            android:label="@string/widget_this_week"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_this_week" />
        </receiver>
        <receiver
            android:name=".widgets.GoalReceiver"
            android:label="@string/widget_goal"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_goal" />
        </receiver>
        <activity
            android:name=".widgets.GoalConfigActivity"
            android:theme="@style/Theme.budgetmint.Dialog"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
