{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "BudgetMint",
  "version": "../package.json",
  "identifier": "com.budgetmint.desktop",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430"
  },
  "app": {
    "windows": [
      {
        "title": "BudgetMint",
        "create": false,
        "width": 1280,
        "height": 860,
        "minWidth": 800,
        "minHeight": 500,
        "center": true,
        "resizable": true,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval' 'unsafe-inline' 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com ws://localhost:1430 http://127.0.0.1:9099 http://127.0.0.1:8085",
        "object-src": "'none'",
        "frame-src": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdGNkMwQkQ1QTNDMzhDNzEKUldSeGpNT2oxUXRzZjVDeTZDU2FUR2NTNy8rUFRiQ1d2eUxMVUZHLzVQV0tNVHhRSVpBUDEyMk0K",
      "endpoints": [
        "https://github.com/BeardedUnicorn/BudgetMint/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Mike Herold",
    "copyright": "Copyright © 2026 Mike Herold",
    "category": "Finance",
    "shortDescription": "Bills and cash flow, TaskMint's companion",
    "longDescription": "BudgetMint tracks your bills and forecasts your cash flow, with TaskMint's payouts in the forecast.",
    "homepage": "https://github.com/BeardedUnicorn/BudgetMint",
    "license": "MIT",
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
