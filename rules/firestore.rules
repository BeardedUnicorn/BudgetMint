rules_version = '2';

// BudgetMint's data in its own Firebase project (budgetmint): each user's
// own, and nobody else's. BudgetMint's release deploys these. TaskMint's
// forecast is in TaskMint's project, under TaskMint's rules (pinned in
// firebase/ for the tests).
//
//   budgetmint/{uid}             { epoch }: deleting the data starts a new
//                                epoch, and writes from an older one are
//                                refused
//   budgetmint/{uid}/data/{id}   one settings, item, occurrence or bank
//                                account:
//                                { kind, json, schema, deviceId, epoch,
//                                updatedAt }. Its JSON is core's
//                                (crates/budgetmint-core/src/docs.rs), so the
//                                model changes without a change here; a new
//                                kind needs one.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /budgetmint/{uid} {
      allow read: if signedInAs(uid);
      allow create: if signedInAs(uid)
        && request.resource.data.keys().hasOnly(['epoch'])
        && request.resource.data.epoch == 1;
      // One epoch at a time
      allow update: if signedInAs(uid)
        && request.resource.data.keys().hasOnly(['epoch'])
        && request.resource.data.epoch == resource.data.epoch + 1;
      allow delete: if signedInAs(uid);

      function budgetAccount() {
        return get(/databases/$(database)/documents/budgetmint/$(uid)).data;
      }

      function validBudgetDoc(docId) {
        let doc = request.resource.data;
        let fields = ['kind', 'json', 'schema', 'deviceId', 'epoch', 'updatedAt'];
        // Each kind's ids, and how large its JSON may be
        let ids = {
          'settings': 'settings~account',
          'item': 'item~[A-Za-z0-9-]{1,64}',
          'occ': 'occ~[0-9]{4}-[0-9]{2}-[0-9]{2}~[A-Za-z0-9-]{1,64}',
          'account': 'account~[A-Za-z0-9-]{1,64}'
        };
        let sizes = { 'settings': 20000, 'item': 50000, 'occ': 4000, 'account': 20000 };
        return doc.keys().hasOnly(fields)
          && doc.keys().hasAll(fields)
          && doc.kind is string && doc.kind in ids
          && docId.matches(ids[doc.kind])
          && doc.json is string && doc.json.size() <= sizes[doc.kind]
          && doc.schema is int && doc.schema >= 1
          && (resource == null || doc.schema >= resource.data.schema)
          && doc.deviceId is string && doc.deviceId.size() <= 64
          && doc.updatedAt == request.time
          && doc.epoch == budgetAccount().epoch;
      }

      match /data/{docId} {
        allow read: if signedInAs(uid);
        allow create, update: if signedInAs(uid) && validBudgetDoc(docId);
        allow delete: if signedInAs(uid);
      }
    }
  }
}
