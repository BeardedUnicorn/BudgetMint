# Copy this file to .env and fill in what you use.

# Google sign-in on the desktop (optional): BudgetMint's own "Desktop app"
# OAuth client in Google Cloud console → APIs & Services → Credentials,
# project taskmint-f9a05 (both projects' Google sign-in accept it, and so do
# both dev projects', so dev builds use it too). Without them, the desktop
# signs in by email and password.
#
# Which Firebase projects a build uses is BUDGETMINT_ENV, not a .env
# setting: every build is dev (budgetmint-dev and taskmint-dev) unless
# BUDGETMINT_ENV=production, which only a release sets (the README's "Dev
# environment").
VITE_GOOGLE_DESKTOP_CLIENT_ID=
VITE_GOOGLE_DESKTOP_CLIENT_SECRET=

# Development builds only: the Firebase emulators on this host
# (`pnpm firebase --config firebase.emulators.json emulators:start`, as the
# dev project; 10.0.2.2 from the Android emulator). They serve TaskMint's
# project too.
# VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
